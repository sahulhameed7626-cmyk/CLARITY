datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String             @id @default(uuid())
  name          String
  email         String             @unique
  password      String
  role          String             @default("STUDENT") // "STUDENT" | "TEACHER"
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  courses       Course[]           @relation("UserCreatedCourses")
  progress      UserProgress[]
  conversations ChatConversation[]
}

model Course {
  id                String             @id @default(uuid())
  title             String
  slug              String             @unique
  shortDescription  String
  overview          String
  difficulty        String             @default("Beginner")
  estimatedDuration String             @default("6 Weeks")
  prerequisites     String             @default("None")
  pdfUrl            String?
  pdfName           String?
  createdBy         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  author            User               @relation("UserCreatedCourses", fields: [createdBy], references: [id], onDelete: Cascade)
  roadmapItems      RoadmapItem[]
  subtopics         Subtopic[]
  videos            VideoResource[]
  websites          WebsiteResource[]
  userProgress      UserProgress[]
  conversations     ChatConversation[]
}

model RoadmapItem {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Subtopic {
  id          String         @id @default(uuid())
  courseId    String
  title       String
  description String
  content     String
  difficulty  String         @default("Beginner")
  orderIndex  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    UserProgress[]
}

model VideoResource {
  id           String   @id @default(uuid())
  courseId     String
  title        String
  youtubeUrl   String
  thumbnailUrl String?
  channelName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model WebsiteResource {
  id          String   @id @default(uuid())
  courseId    String
  name        String
  url         String
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  subtopicId  String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subtopic    Subtopic  @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  @@unique([userId, subtopicId])
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String
  courseId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  sender         String           // "USER" | "AI"
  message        String
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
