# Server & Auth Settings
PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="CLARITY_super_secret_jwt_key_2026_clarity"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"

# ==============================================================================
# CLARITY AI PROVIDER CONFIGURATION (OpenAI Compatible & Open Source Models)
# ==============================================================================

# Option 1: Local Open-Source AI Model via Ollama (Default, Free, Local)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3
AI_API_KEY=""

# Option 2: OpenAI API (Cloud)
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=your-openai-api-key

# Option 3: Groq Cloud API (Superfast Llama3/Mistral models)
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=your-groq-api-key

# Option 4: OpenRouter (Universal Open-Source Model Router)
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3-8b-instruct
# AI_API_KEY=your-openrouter-api-key

# Option 5: Google Gemini REST API
# AI_PROVIDER=gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_MODEL=gemini-1.5-flash
# AI_API_KEY=your-gemini-api-key
